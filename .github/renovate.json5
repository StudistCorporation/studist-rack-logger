{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>studistcorporation/.github:default.json5",

    // https://docs.renovatebot.com/presets-default/
    ":disableMajorUpdates",
  ],

  // https://docs.renovatebot.com/key-concepts/scheduling/
  schedule: ["after 9am on monday"],

  // https://docs.renovatebot.com/configuration-options/#minimumreleaseage
  minimumReleaseAge: "7 days",

  branchPrefix: "develop/renovete-",
  reviewers: [
    "corrupt952", // FIXME: Debug assignees
  ],
}
